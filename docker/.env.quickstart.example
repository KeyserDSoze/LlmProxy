# Private GitHub Container Registry image
GHCR_OWNER=keyserdsoze
LLMPROXY_IMAGE_TAG=main

# Local HTTP port on the VM
LLMPROXY_PORT=8080

# PostgreSQL
POSTGRES_DB=llmproxy
POSTGRES_USER=llmproxy
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# Bootstrap inference bearer key used for initial tests.
# Replace before any shared/non-local deployment.
LLM_PROXY_API_KEY=CHANGE_ME_INFERENCE_KEY
LLM_PROXY_API_KEY_PEPPER=CHANGE_ME_LONG_RANDOM_PEPPER

# For the first test leave Entra disabled. Enable it only after the app registration exists.
ASPNETCORE_ENVIRONMENT=Development
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Initial routing policy. PostgreSQL becomes authoritative after initialization.
ROUTING_STRATEGY=WeightedLeastLoaded

# Health / runtime metrics
HEALTH_INTERVAL_SECONDS=10
HEALTH_HEALTHY_AFTER_SUCCESSES=2
HEALTH_UNHEALTHY_AFTER_FAILURES=3
RUNTIME_METRICS_ENABLED=true
RUNTIME_METRICS_INTERVAL_SECONDS=5
HARDWARE_METRICS_ENABLED=false
HARDWARE_METRICS_INTERVAL_SECONDS=10

# PostgreSQL data retention. Request metrics are shorter-lived than audit by default.
RETENTION_ENABLED=true
RETENTION_REQUEST_METRICS_DAYS=90
RETENTION_AUDIT_EVENTS_DAYS=365
RETENTION_INTERVAL_HOURS=24
RETENTION_BATCH_SIZE=5000

# Initial inference node. Use the complete vLLM/OpenAI-compatible service root.
# Example with a real DGX: http://10.0.0.21:8000
# Example with a mock running on the same Linux VM: http://host.docker.internal:3450/primopath
BOOTSTRAP_ENABLED=true
DGX_NODE_NAME=dgx-01
DGX_NODE_BASE_ADDRESS=http://10.0.0.21:8000
DGX_HARDWARE_METRICS_BASE_ADDRESS=
DGX_NODE_WEIGHT=1
DGX_NODE_MAX_CONCURRENCY=4
PUBLIC_MODEL_NAME=agic-code-fast
PROVIDER_MODEL_NAME=CHANGE_ME_TO_VLLM_MODEL_NAME
