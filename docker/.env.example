# PostgreSQL
POSTGRES_DB=llmproxy
POSTGRES_USER=llmproxy
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# Gateway bootstrap credential. This is inserted into PostgreSQL on first start.
LLMPROXY_PORT=8080
LLM_PROXY_API_KEY=CHANGE_ME_COPILOT_PROVIDER_KEY
# Stable secret used as HMAC pepper for all stored API-key hashes. Back it up securely and do not rotate without a credential migration plan.
LLM_PROXY_API_KEY_PEPPER=CHANGE_ME_LONG_RANDOM_PEPPER

# Microsoft Entra ID - required in Production
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Initial routing policy. Used only if PostgreSQL does not already contain a routing policy.
# After first start change it live from the Admin UI/API.
ROUTING_STRATEGY=WeightedLeastLoaded

# inference node health monitoring. A node becomes Degraded on the first failed probe,
# Unhealthy after the configured failure streak, and Healthy after the configured success streak.
HEALTH_INTERVAL_SECONDS=10
HEALTH_HEALTHY_AFTER_SUCCESSES=2
HEALTH_UNHEALTHY_AFTER_FAILURES=3

# Optional vLLM Prometheus telemetry. When enabled, the gateway polls <service-root>/metrics
# and keeps queue/running/KV-cache signals in memory for routing and the Admin UI.
# Missing/unavailable metrics never make a node unhealthy by themselves.
RUNTIME_METRICS_ENABLED=true
RUNTIME_METRICS_INTERVAL_SECONDS=5

# Optional NVIDIA/DCGM Prometheus telemetry. This collector is independent from vLLM health/routing.
# Each node may use a separate DCGM exporter service root, typically http://<dgx-host>:9400.
HARDWARE_METRICS_ENABLED=true
HARDWARE_METRICS_INTERVAL_SECONDS=10

# Initial inference node bootstrap. The full service-root URL is supported: hostname/IP, port and optional path prefix.
# Examples: http://localhost:3450/primopath, http://10.0.0.25:8000, https://inference-01.internal:8443/vllm
BOOTSTRAP_ENABLED=true
INFERENCE_NODE_NAME=inference-01
INFERENCE_NODE_BASE_ADDRESS=http://10.0.0.10:8000
# Optional hardware metrics service root. LlmProxy appends /metrics.
INFERENCE_NODE_HARDWARE_METRICS_BASE_ADDRESS=http://10.0.0.10:9400
INFERENCE_NODE_WEIGHT=1
INFERENCE_NODE_MAX_CONCURRENCY=4
PUBLIC_MODEL_NAME=agic-code-fast
PROVIDER_MODEL_NAME=CHANGE_ME_TO_VLLM_MODEL_NAME

# Production container publication/deployment
GHCR_OWNER=keyserdsoze
LLMPROXY_IMAGE_TAG=main
CLOUDFLARE_TUNNEL_TOKEN=
