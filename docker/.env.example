# PostgreSQL
POSTGRES_DB=llmproxy
POSTGRES_USER=llmproxy
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# Gateway bootstrap credential. This is inserted into PostgreSQL on first start.
LLMPROXY_PORT=8080
LLM_PROXY_API_KEY=CHANGE_ME_COPILOT_PROVIDER_KEY
# Stable secret used as HMAC pepper for all stored API-key hashes. Back it up securely and do not rotate without a credential migration plan.
LLM_PROXY_API_KEY_PEPPER=CHANGE_ME_LONG_RANDOM_PEPPER

# Routing strategy: WeightedLeastLoaded (recommended for long-lived LLM streams),
# RoundRobin, or WeightedRoundRobin.
ROUTING_STRATEGY=WeightedLeastLoaded

# Microsoft Entra ID - required in Production
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Initial DGX bootstrap. NodeBaseAddress is the COMPLETE service root and may contain
# localhost, an IP address, port, and an optional path prefix. Examples:
#   http://localhost:3450/primopath
#   http://127.0.0.1:8000
#   http://10.0.0.25:8000/vllm
# LlmProxy appends /health, /v1/chat/completions, or /v1/responses to this root.
BOOTSTRAP_ENABLED=true
DGX_NODE_NAME=dgx-01
DGX_NODE_BASE_ADDRESS=http://10.0.0.10:8000
DGX_NODE_WEIGHT=1
DGX_NODE_MAX_CONCURRENCY=4
PUBLIC_MODEL_NAME=agic-code-fast
PROVIDER_MODEL_NAME=CHANGE_ME_TO_VLLM_MODEL_NAME

# Production container publication/deployment
GHCR_OWNER=keyserdsoze
LLMPROXY_IMAGE_TAG=main
CLOUDFLARE_TUNNEL_TOKEN=
