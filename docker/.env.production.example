# LlmProxy Linux production environment
# Copy to /opt/llmproxy/.env and replace every CHANGE_ME value before deployment.

# Published image
GHCR_OWNER=keyserdsoze
LLMPROXY_IMAGE_TAG=main
LLMPROXY_PULL_POLICY=always

# Host exposure. Keep Grafana loopback-only unless you deliberately publish it through a protected reverse proxy.
LLMPROXY_BIND_ADDRESS=0.0.0.0
LLMPROXY_PORT=8080
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000

# Environment / instance identity
ASPNETCORE_ENVIRONMENT=Production
DEPLOYMENT_ENVIRONMENT=production
LLMPROXY_INSTANCE_ID=llmproxy-prod-1

# PostgreSQL
POSTGRES_DB=llmproxy
POSTGRES_USER=llmproxy
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Redis shared runtime/coordination
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_KEY_PREFIX=llmproxy
REDIS_RECONCILE_SECONDS=5
REDIS_OUTBOX_BATCH_SIZE=50
REDIS_OUTBOX_POLL_MILLISECONDS=500
REDIS_CAPACITY_LEASE_SECONDS=120
REDIS_CAPACITY_RENEW_SECONDS=30

# Initial inference bearer credential + stable HMAC pepper.
# Preserve the pepper outside the VM as a recovery dependency.
LLM_PROXY_API_KEY=CHANGE_ME_LLM_PROXY_API_KEY
LLM_PROXY_API_KEY_PEPPER=CHANGE_ME_LLM_PROXY_API_KEY_PEPPER

# Stable 32-byte hex master key for recoverable upstream provider credentials.
# Preserve it outside the host together with LLM_PROXY_API_KEY_PEPPER.
LLMPROXY_UPSTREAM_CREDENTIAL_KEY=CHANGE_ME_UPSTREAM_CREDENTIAL_KEY

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD

# Entra ID. Production deployment requires this to be enabled with all required values.
# The installer may create the file before identity values are supplied, but deploy.sh
# intentionally refuses ASPNETCORE_ENVIRONMENT=Production while ENTRA_ENABLED=false.
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Optional Cloudflare Tunnel. Leave blank during private-LAN bootstrap.
# When non-empty, docker/scripts/deploy.sh automatically enables the cloudflare Compose profile.
CLOUDFLARE_TUNNEL_TOKEN=
# Set automatically by the Linux installer when a Cloudflare Tunnel token is configured.
# When true, ASP.NET accepts one direct X-Forwarded-* proxy hop for HTTPS/OIDC callback generation.
REVERSE_PROXY_ENABLED=false

# Routing / health
ROUTING_STRATEGY=WeightedLeastLoaded
HEALTH_INTERVAL_SECONDS=10
HEALTH_HEALTHY_AFTER_SUCCESSES=2
HEALTH_UNHEALTHY_AFTER_FAILURES=3
RUNTIME_METRICS_ENABLED=true
RUNTIME_METRICS_INTERVAL_SECONDS=5
HARDWARE_METRICS_ENABLED=false
HARDWARE_METRICS_INTERVAL_SECONDS=10

# Retention
RETENTION_ENABLED=true
RETENTION_REQUEST_METRICS_DAYS=90
RETENTION_USAGE_ROLLUPS_DAYS=730
RETENTION_AUDIT_EVENTS_DAYS=365
RETENTION_RUNTIME_STATE_OUTBOX_DAYS=30
RETENTION_INTERVAL_HOURS=24
RETENTION_BATCH_SIZE=5000

# Initial DGX/vLLM bootstrap. Both values are intentionally explicit placeholders so
# an unattended installer cannot accidentally deploy against an example address/model.
BOOTSTRAP_ENABLED=true
DGX_NODE_NAME=dgx-01
DGX_NODE_BASE_ADDRESS=CHANGE_ME_DGX_NODE_BASE_ADDRESS
# Optional one-time bootstrap bearer. The installer consumes it from the shell and
# removes it from the long-lived LlmProxy container environment after encryption.
DGX_UPSTREAM_BEARER_TOKEN=
DGX_HARDWARE_METRICS_BASE_ADDRESS=
DGX_NODE_WEIGHT=1
DGX_NODE_MAX_CONCURRENCY=4
PUBLIC_MODEL_NAME=agic-code-fast
PROVIDER_MODEL_NAME=CHANGE_ME_TO_VLLM_MODEL_NAME
