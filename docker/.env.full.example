# LlmProxy full-stack installation
# Copy to docker/.env.full or run docker/scripts/full-stack-init.sh / .ps1.

# Private GitHub Container Registry image
GHCR_OWNER=keyserdsoze
LLMPROXY_IMAGE_TAG=main

# Public ports
LLMPROXY_PORT=8080
GRAFANA_PORT=3000

# Instance / environment labels
LLMPROXY_INSTANCE_ID=llmproxy-1
DEPLOYMENT_ENVIRONMENT=demo

# PostgreSQL
POSTGRES_DB=llmproxy
POSTGRES_USER=llmproxy
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Redis. The internal connection string is auto-wired by Docker Compose.
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_KEY_PREFIX=llmproxy
REDIS_RECONCILE_SECONDS=5
REDIS_OUTBOX_BATCH_SIZE=50
REDIS_OUTBOX_POLL_MILLISECONDS=500

# Initial inference bearer credential and HMAC pepper.
# The secret is shown here only because this local file is the operator-owned source.
LLM_PROXY_API_KEY=CHANGE_ME_LLM_PROXY_API_KEY
LLM_PROXY_API_KEY_PEPPER=CHANGE_ME_LLM_PROXY_API_KEY_PEPPER

# Stable master key for recoverable upstream provider credentials.
# Preserve it outside the host together with LLM_PROXY_API_KEY_PEPPER.
LLMPROXY_UPSTREAM_CREDENTIAL_KEY=CHANGE_ME_UPSTREAM_CREDENTIAL_KEY

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD

# For first tests keep Development + Entra disabled.
ASPNETCORE_ENVIRONMENT=Development
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Optional Jev-compatible System One classifier upstream (for example Laya).
SYSTEM_ONE_ENABLED=false
SYSTEM_ONE_BASE_ADDRESS=
SYSTEM_ONE_API_KEY=
SYSTEM_ONE_TIMEOUT_SECONDS=30

# Routing / health
ROUTING_STRATEGY=WeightedLeastLoaded
HEALTH_INTERVAL_SECONDS=10
HEALTH_HEALTHY_AFTER_SUCCESSES=2
HEALTH_UNHEALTHY_AFTER_FAILURES=3
RUNTIME_METRICS_ENABLED=true
RUNTIME_METRICS_INTERVAL_SECONDS=5
HARDWARE_METRICS_ENABLED=false
HARDWARE_METRICS_INTERVAL_SECONDS=10

# Data retention. Raw request metrics stay granular for 90 days by default;
# daily historical usage rollups preserve reporting for 730 days.
# Runtime-state outbox retention only deletes already-processed rows.
RETENTION_ENABLED=true
RETENTION_REQUEST_METRICS_DAYS=90
RETENTION_USAGE_ROLLUPS_DAYS=730
RETENTION_AUDIT_EVENTS_DAYS=365
RETENTION_RUNTIME_STATE_OUTBOX_DAYS=30
RETENTION_INTERVAL_HOURS=24
RETENTION_BATCH_SIZE=5000

# Initial inference node. Internal PostgreSQL/Redis/OTel URLs do NOT belong here;
# Compose injects them automatically.
BOOTSTRAP_ENABLED=true
INFERENCE_NODE_NAME=inference-01
INFERENCE_NODE_BASE_ADDRESS=http://10.0.0.21:8000
# Optional one-time bootstrap bearer for llama.cpp/vLLM.
# Prefer passing it as INFERENCE_NODE_UPSTREAM_BEARER_TOKEN in the installer shell.
INFERENCE_NODE_UPSTREAM_BEARER_TOKEN=
INFERENCE_NODE_HARDWARE_METRICS_BASE_ADDRESS=
INFERENCE_NODE_WEIGHT=1
INFERENCE_NODE_MAX_CONCURRENCY=4
PUBLIC_MODEL_NAME=agic-code-fast
PROVIDER_MODEL_NAME=CHANGE_ME_TO_VLLM_MODEL_NAME
