ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:9900
NodeAgent__BearerToken=CHANGE_ME_LONG_RANDOM_SECRET
NodeAgent__AdvertiseHost=10.0.0.21
NodeAgent__DockerImage=vllm/vllm-openai:latest
NodeAgent__DataDirectory=/var/lib/llmproxy-node-agent
NodeAgent__ModelCacheDirectory=/var/lib/llmproxy-node-agent/huggingface
NodeAgent__UseNvidiaGpus=true
NodeAgent__PrefetchModels=true

# Optional Agent-initiated automatic enrollment. Set once from the Admin pairing invitation.
NodeAgent__GatewayBaseAddress=
NodeAgent__EnrollmentToken=
# Per-node recovery code is only loaded during explicit Admin repair. The Agent
# wipes these bootstrap values after a successful recovery; its enrolled state
# persists in NodeAgent__DataDirectory/gateway-connection.json across restarts.
NodeAgent__RecoveryNodeId=
NodeAgent__RecoveryToken=
NodeAgent__ForceRecovery=false
# "outbound" works across NAT and other networks for discovery/heartbeat.
# "direct" additionally exposes management HTTP if a private route exists.
NodeAgent__ConnectionMode=outbound
