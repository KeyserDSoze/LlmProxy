ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://172.17.0.1:9910
UpdateAgent__BearerToken=CHANGE_ME_LONG_RANDOM_SECRET
UpdateAgent__InstallDirectory=/opt/llmproxy
UpdateAgent__BootstrapPath=/usr/local/lib/llmproxy/bootstrap.sh
UpdateAgent__StateDirectory=/var/lib/llmproxy-update-agent
UpdateAgent__CommandTimeoutMinutes=180
