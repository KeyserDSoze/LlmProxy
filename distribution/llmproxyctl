#!/usr/bin/env bash
set -euo pipefail

INSTALL_DIR="${LLMPROXY_INSTALL_DIR:-/opt/llmproxy}"
ENV_FILE="${LLMPROXY_ENV_FILE:-$INSTALL_DIR/.env}"
RUNTIME_COMPOSE="$INSTALL_DIR/runtime/docker-compose.full.yml"
CURRENT_LINK="$INSTALL_DIR/current"
BOOTSTRAP="/usr/local/lib/llmproxy/bootstrap.sh"

usage() {
  cat <<'USAGE'
Usage: llmproxyctl COMMAND [args]

Commands:
  status                     Show containers and gateway health
  health                     Probe /healthz and /readyz
  logs [service]            Follow logs (default: llmproxy)
  start                      Start the installed stack
  stop                       Stop running containers without deleting data
  restart                    Restart the installed stack
  doctor                     Validate Docker, Compose, config and gateway health
  version                    Show installed bundle and configured image version
  update VERSION [options]   Install/update; supports --super-admins USERS
  rollback VERSION            Redeploy a previously installed local release bundle
  config-path                Print the protected environment file path
  help                       Show this help

Updates preserve /opt/llmproxy/.env and Docker volumes. Public GitHub Release
assets download without authentication. Provide GitHub/GHCR credentials only
when repository or container-package access requires them.
USAGE
}

require_env() {
  if [[ ! -f "$ENV_FILE" ]]; then
    echo "LlmProxy environment not found: $ENV_FILE" >&2
    exit 2
  fi
}

read_env() {
  local key="$1"
  sed -n "s/^${key}=//p" "$ENV_FILE" | tail -n 1 | tr -d '\\r'
}

compose() {
  require_env
  if [[ ! -f "$RUNTIME_COMPOSE" ]]; then
    echo "Runtime compose file not found: $RUNTIME_COMPOSE" >&2
    exit 2
  fi
  local args=(docker compose --env-file "$ENV_FILE" -f "$RUNTIME_COMPOSE")
  if [[ -n "$(read_env CLOUDFLARE_TUNNEL_TOKEN)" ]]; then
    args+=(--profile cloudflare)
  fi
  "${args[@]}" "$@"
}

port() {
  local value
  value="$(read_env LLMPROXY_PORT)"
  printf '%s\n' "${value:-8080}"
}

health() {
  require_env
  local p
  p="$(port)"
  curl --fail --silent --show-error "http://127.0.0.1:$p/healthz"
  printf '\n'
  curl --fail --silent --show-error "http://127.0.0.1:$p/readyz"
  printf '\n'
}

require_root() {
  if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
    echo "This command changes the installation. Re-run with sudo -E." >&2
    exit 2
  fi
}

set_env_value() {
  local key="$1"
  local value="$2"
  local tmp
  tmp="$(mktemp)"
  awk -v key="$key" -v value="$value" '
    BEGIN { found = 0 }
    index($0, key "=") == 1 { print key "=" value; found = 1; next }
    { print }
    END { if (!found) print key "=" value }
  ' "$ENV_FILE" > "$tmp"
  cat "$tmp" > "$ENV_FILE"
  rm -f "$tmp"
}

installed_version() {
  if [[ -L "$CURRENT_LINK" && -f "$CURRENT_LINK/VERSION" ]]; then
    tr -d '[:space:]' < "$CURRENT_LINK/VERSION"
    return
  fi
  read_env LLMPROXY_IMAGE_TAG
}

version_lt() {
  local left="$1" right="$2"
  [[ "$left" != "$right" && "$(printf '%s\n%s\n' "$left" "$right" | sort -V | head -n 1)" == "$left" ]]
}

version_le() {
  local left="$1" right="$2"
  [[ "$left" == "$right" || "$(printf '%s\n%s\n' "$left" "$right" | sort -V | head -n 1)" == "$left" ]]
}

resolve_update_path() {
  local target="$1"
  local current
  current="$(installed_version)"
  if [[ ! "$current" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ || ! "$target" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "Safe multi-release update requires stable SemVer versions (current=$current target=$target)." >&2
    return 1
  fi
  if [[ "$current" == "$target" ]]; then
    printf '%s\n' "$target"
    return 0
  fi
  if ! version_lt "$current" "$target"; then
    echo "Update target v$target must be newer than installed v$current. Use rollback for an older installed release." >&2
    return 1
  fi
  if ! command -v jq >/dev/null 2>&1; then
    echo "jq is required to resolve the complete safe update chain." >&2
    return 1
  fi

  local repository="${LLMPROXY_GITHUB_REPOSITORY:-KeyserDSoze/LlmProxy}"
  local token="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
  local page=1 count tag version_value
  local tmp
  tmp="$(mktemp)"
  : > "$tmp"

  while (( page <= 20 )); do
    local page_file
    page_file="$(mktemp)"
    local curl_args=(--fail --silent --show-error --retry 8 --retry-delay 2 --retry-all-errors --retry-max-time 300 --connect-timeout 15
      -H "Accept: application/vnd.github+json"
      -H "X-GitHub-Api-Version: 2022-11-28")
    if [[ -n "$token" ]]; then
      curl_args+=(-H "Authorization: Bearer $token")
    fi
    if ! curl "${curl_args[@]}" "https://api.github.com/repos/$repository/releases?per_page=100&page=$page" -o "$page_file"; then
      rm -f "$page_file" "$tmp"
      echo "Could not resolve published releases; refusing to skip an unknown intermediate update." >&2
      return 1
    fi
    count="$(jq 'length' "$page_file")"
    jq -r '.[] | select(.draft != true and .prerelease != true) | .tag_name | select(test("^v?[0-9]+\\.[0-9]+\\.[0-9]+$"))' "$page_file" >> "$tmp"
    rm -f "$page_file"
    (( count < 100 )) && break
    page=$((page + 1))
  done

  local -a path=()
  while IFS= read -r tag; do
    version_value="${tag#v}"
    if version_lt "$current" "$version_value" && version_le "$version_value" "$target"; then
      path+=("$version_value")
    fi
  done < <(sort -Vu "$tmp")
  rm -f "$tmp"

  if [[ "${#path[@]}" -eq 0 || "${path[-1]}" != "$target" ]]; then
    echo "Target v$target is not a published stable release or the complete upgrade chain could not be resolved." >&2
    return 1
  fi

  printf '%s\n' "${path[@]}"
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  status)
    compose ps
    printf '\nGateway health:\n'
    health || true
    ;;
  health)
    health
    ;;
  logs)
    service="${1:-llmproxy}"
    compose logs -f "$service"
    ;;
  start)
    require_root
    compose up -d --no-build --remove-orphans
    ;;
  stop)
    require_root
    compose stop
    ;;
  restart)
    require_root
    compose restart
    ;;
  doctor)
    printf 'Architecture: %s\n' "$(uname -m)"
    printf 'Install dir: %s\n' "$INSTALL_DIR"
    command -v docker >/dev/null || { echo 'Docker: MISSING'; exit 1; }
    docker version --format 'Docker: {{.Server.Version}}'
    docker compose version
    require_env
    printf 'Environment: %s\n' "$ENV_FILE"
    printf 'Configured image tag: %s\n' "$(read_env LLMPROXY_IMAGE_TAG)"
    [[ -L "$CURRENT_LINK" ]] && printf 'Current release: %s\n' "$(readlink -f "$CURRENT_LINK")" || true
    compose config >/dev/null
    printf 'Compose config: OK\n'
    health
    ;;
  version)
    require_env
    configured="$(read_env LLMPROXY_IMAGE_TAG)"
    installed="unknown"
    if [[ -L "$CURRENT_LINK" && -f "$CURRENT_LINK/VERSION" ]]; then
      installed="$(tr -d '[:space:]' < "$CURRENT_LINK/VERSION")"
    fi
    printf 'Installed bundle: %s\n' "$installed"
    printf 'Configured image: %s\n' "$configured"
    ;;
  update)
    require_root
    version="${1:?Usage: sudo -E llmproxyctl update VERSION [--super-admins USERS]}"
    shift
    update_args=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --super-admins)
          if [[ $# -lt 2 ]]; then
            echo "--super-admins requires a value (use an empty quoted value to clear the list)." >&2
            exit 2
          fi
          update_args+=("$1" "$2")
          shift 2
          ;;
        *)
          echo "Unsupported update option: $1" >&2
          echo "Supported: --super-admins USERS" >&2
          exit 2
          ;;
      esac
    done
    if [[ ! -x "$BOOTSTRAP" ]]; then
      echo "Bootstrap helper is missing: $BOOTSTRAP" >&2
      exit 2
    fi
    # Resolve every published stable release between the installed version and the target.
    # This makes manual jumps obey the same migration/custom-plan ordering as Admin/auto-update.
    mapfile -t upgrade_path < <(resolve_update_path "$version")
    if [[ "${#upgrade_path[@]}" -eq 0 ]]; then
      echo "Could not resolve a safe update path to v$version." >&2
      exit 3
    fi
    printf 'Safe update path: %s\n' "$(printf 'v%s → ' "${upgrade_path[@]}" | sed 's/ → $//')"

    # Existing protected-node provider credentials are intentionally not recoverable from
    # host configuration. Each step reuses persisted encrypted credentials and validates
    # gateway readiness before the next immutable release is attempted.
    for step in "${upgrade_path[@]}"; do
      printf '\nApplying LlmProxy v%s...\n' "$step"
      "$BOOTSTRAP" --version "$step" --skip-docker-install --skip-node-check --non-interactive --upgrade "${update_args[@]}"
    done
    ;;
  rollback)
    require_root
    version="${1:?Usage: sudo llmproxyctl rollback VERSION}"
    release_dir="$INSTALL_DIR/releases/$version"
    if [[ ! -f "$release_dir/docker/scripts/deploy.sh" ]]; then
      echo "Release $version is not installed locally under $INSTALL_DIR/releases." >&2
      exit 2
    fi
    require_env
    set_env_value LLMPROXY_IMAGE_TAG "$version"
    LLMPROXY_DEPLOY_DIR="$INSTALL_DIR" \
    LLMPROXY_ENV_FILE="$ENV_FILE" \
      bash "$release_dir/docker/scripts/deploy.sh" "$version"
    ln -sfn "$release_dir" "$CURRENT_LINK"
    install -m 0755 "$release_dir/distribution/llmproxyctl" /usr/local/bin/llmproxyctl
    install -m 0755 "$release_dir/distribution/bootstrap.sh" "$BOOTSTRAP"
    ;;
  config-path)
    printf '%s\n' "$ENV_FILE"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
